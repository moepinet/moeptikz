		\pgflineto{\northeast \pgf@x=.75\pgf@x \pgf@y=0pt}
		\pgflineto{\northeast \pgf@x=.15\pgf@x \pgf@y=.15\pgf@y}
		\pgflineto{\northeast \pgf@x=.15\pgf@x \pgf@y=.15\pgf@y}
		\pgflineto{\northeast \pgf@x=.15\pgf@x \pgf@y=.075\pgf@y}
   		\pgfclosepath
		\pgfusepath{fill}
	}
