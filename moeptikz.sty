\newif\ifmoeptikz@shading
\define@key{moeptikz}{shading}[true]{%
	\pgfutil@ifundefined{moeptikz@shading#1}{%
		\PackageError{moeptikz}{Invalid value `#1' for key `shading'}%
			{Use shading=true or shading=false.}%
	}{%
		\csname moeptikz@shading#1\endcsname
	}%
}

% Every shading declaration immediately writes a new object to the PDF.  Hence
% shadings are declared only once per distinct key (e.g. shading mode and fill
% colour) and cached globally.
%
% \moeptikz@cachedshading{<alias>}{<cache key>}{<declaration code>}
% The declaration code is executed only the first time <cache key> is used and
% must declare a shading named \moeptikz@shadingname.  Afterwards the shading
% <alias> refers to the cached shading.
\newcount\moeptikz@shadingcount
\def\moeptikz@cachedshading#1#2#3{%
	\pgfutil@ifundefined{moeptikz@shk@#2}{%
		\global\advance\moeptikz@shadingcount by 1\relax
		\expandafter\xdef\csname moeptikz@shk@#2\endcsname{%
			moeptikz@sh@\the\moeptikz@shadingcount}%
		\edef\moeptikz@shadingname{\csname moeptikz@shk@#2\endcsname}%
		#3%
	}{}%
	\edef\moeptikz@tmp{%
		\noexpand\pgfaliasshading{#1}{\csname moeptikz@shk@#2\endcsname}}%
	\moeptikz@tmp
}

% Provides the shadings moeptikz@shading and moeptikz@shadingnuc for the
% current fill colour (or the current colour if no fill colour is set).
\def\moeptikz@setshading{%
	\ifx\tikz@fillcolor\pgfutil@empty
		\pgfutil@colorlet{moeptikz@fill}{.}%
	\else
		\pgfutil@colorlet{moeptikz@fill}{\tikz@fillcolor}%
	\fi
	\extractcolorspec{moeptikz@fill}\moeptikz@fillspec
	\edef\moeptikz@key{%
		\ifmoeptikz@shading on\else off\fi:%
		\detokenize\expandafter{\moeptikz@fillspec}}%
	\moeptikz@cachedshading{moeptikz@shading}{main:\moeptikz@key}{%
		\ifmoeptikz@shading
			\pgfdeclareradialshading{\moeptikz@shadingname}{\pgfpoint{-25bp}{-25bp}}{%
				rgb(0bp)=(1,1,1);
				color(20bp)=(moeptikz@fill!20);
				color(50bp)=(moeptikz@fill!60)
			}%
		\else
			\pgfdeclareradialshading{\moeptikz@shadingname}{\pgfpoint{0}{0}}{%
				color(0bp)=(moeptikz@fill!30);
				color(100bp)=(moeptikz@fill!30)
			}%
		\fi
	}%
	\moeptikz@cachedshading{moeptikz@shadingnuc}{nuc:\moeptikz@key}{%
		\ifmoeptikz@shading
			\pgfdeclareradialshading{\moeptikz@shadingname}{\pgfpoint{-25bp}{-25bp}}{%
				rgb(0bp)=(1,1,1);
				color(20bp)=(moeptikz@fill!70);
				color(50bp)=(moeptikz@fill!90)
			}%
		\else
			\pgfdeclareradialshading{\moeptikz@shadingname}{\pgfpoint{0}{0}}{%
				color(0bp)=(moeptikz@fill!70);
				color(100bp)=(moeptikz@fill!70)
			}%
		\fi
	}%
}

\DeclareDocumentCommand{\moeptikzset}{m}{%
	\setkeys{moeptikz}{#1}%
}

\moeptikzset{shading=true}

\DeclareOption{shading}{\moeptikzset{shading=true}}
