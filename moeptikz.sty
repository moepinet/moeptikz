% Saved macros of every shape, evaluated once when the node is created:
% \moeptikz@size  the size, so that expressions like `minimum size=1cm+2mm'
%                 work
% \moeptikz@ysep  outer ysep + inner ysep, the gap between shape and node text
\def\moeptikz@savedmacros{%
	\savedmacro\moeptikz@size{%
		{%
			\pgfmathsetlength\pgf@xa{\pgfkeysvalueof{/pgf/minimum width}}%
			\xdef\moeptikz@size@tmp{\the\pgf@xa}%
		}%
		\let\moeptikz@size\moeptikz@size@tmp
	}%
	\savedmacro\moeptikz@ysep{%
		{%
			\pgfmathsetlength\pgf@ya{\pgfkeysvalueof{/pgf/inner ysep}}%
			\pgfmathaddtolength\pgf@ya{\pgfkeysvalueof{/pgf/outer ysep}}%
			\xdef\moeptikz@ysep@tmp{\the\pgf@ya}%
		}%
		\let\moeptikz@ysep\moeptikz@ysep@tmp
	}%
}


%==============================================================================
% Border of the shapes
%==============================================================================
% Lines between nodes, e.g. \draw (a) -- (b), and anchors given as an angle,
% e.g. (a.30), end on the border of a shape.  PGF asks a shape for such a
% border point by running its \anchorborder code: on entry (\pgf@x,\pgf@y) is a
% vector pointing from the node center in the requested direction.  It is
% given in the node's own coordinate system, i.e. position, rotation and
% scaling of the node are already undone.  The code has to leave the border
% point in (\pgf@x,\pgf@y), again relative to the node center.
%
% The outline of a shape consists of one or more polygons, each given as a list
% of vertices {x1}{y1}{x2}{y2}... in units of half the node size, i.e. (1,1) is
% the upper right corner of the node's bounding box.  The border point is the
% intersection of the ray from the center with the polygons.  If the ray
% crosses them several times (non-convex outlines, antennas), the crossing
% farthest away from the center is used: that is where a line coming from
% outside first touches the shape.
%
% The computations use e-TeX's \dimexpr, numbers are stored as dimensions in pt
% (1pt means 1.0).  \dimexpr computes a*b/c with a 64-bit intermediate result,
% so there is neither an overflow nor a loss of precision.
\newdimen\moeptikz@dx
\newdimen\moeptikz@dy
\newdimen\moeptikz@t
\newif\ifmoeptikz@direction
\def\moeptikz@stop{\moeptikz@stop}

% Scales the direction (\pgf@x,\pgf@y) such that max(|dx|,|dy|) = 1 and stores
% it in (\moeptikz@dx,\moeptikz@dy).  \ifmoeptikz@direction is false for a
% zero direction, i.e. if the target point coincides with the node center.
\def\moeptikz@normalize{%
	\pgf@xa=\ifdim\pgf@x<0pt -\fi\pgf@x
	\pgf@ya=\ifdim\pgf@y<0pt -\fi\pgf@y
	\ifdim\pgf@ya>\pgf@xa \pgf@xa=\pgf@ya \fi
	\ifdim\pgf@xa<0.001pt
		\moeptikz@directionfalse
	\else
		\moeptikz@directiontrue
		\moeptikz@dx=\dimexpr 1pt*\number\pgf@x/\number\pgf@xa\relax
		\moeptikz@dy=\dimexpr 1pt*\number\pgf@y/\number\pgf@xa\relax
	\fi
}

% Stores the border point t*(dx,dy)*size/2 in (\pgf@x,\pgf@y), t=\moeptikz@t.
\def\moeptikz@borderpoint{%
	\pgf@xa=.5\dimexpr\moeptikz@size\relax
	\pgf@x=\dimexpr\moeptikz@t*\number\moeptikz@dx/65536\relax
	\pgf@y=\dimexpr\moeptikz@t*\number\moeptikz@dy/65536\relax
	\pgf@x=\dimexpr\pgf@xa*\number\pgf@x/65536\relax
	\pgf@y=\dimexpr\pgf@xa*\number\pgf@y/65536\relax
}

% \moeptikz@edge{x1}{y1}{x2}{y2}
% Intersects the ray t*d, t>0, d=(dx,dy) with the edge P + s*e, 0<=s<=1, where
% P=(x1,y1) and e=(x2,y2)-P.  With the cross product a x b = ax*by - ay*bx the
% solution of t*d = P + s*e is
%   t = (P x e)/(d x e)   and   s = (P x d)/(d x e).
% \moeptikz@t is set to t if t is larger than the value found so far.
\def\moeptikz@edge#1#2#3#4{%
	\pgf@xa=\dimexpr#3pt-#1pt\relax % e
	\pgf@ya=\dimexpr#4pt-#2pt\relax
	\pgf@xb=\dimexpr\moeptikz@dx*\number\pgf@ya/65536
		-\moeptikz@dy*\number\pgf@xa/65536\relax % d x e
	\pgf@yb=\dimexpr#1\pgf@ya-#2\pgf@xa\relax % P x e
	\pgf@xc=\dimexpr#1\moeptikz@dy-#2\moeptikz@dx\relax % P x d
	\ifdim\pgf@xb<0pt
		\pgf@xb=-\pgf@xb \pgf@yb=-\pgf@yb \pgf@xc=-\pgf@xc
	\fi
	% d x e = 0: the ray is parallel to the edge.  The tolerance of 0.1% for s
	% catches rays through a vertex despite rounding errors.  t < 16 excludes
	% garbage (the outlines lie within |x|,|y| < 2) and prevents an overflow.
	\ifdim\pgf@xb>0pt
	\ifdim\pgf@xc>-.001\pgf@xb
	\ifdim\pgf@xc<1.001\pgf@xb
	\ifdim\pgf@yb>0pt
	\ifdim\pgf@yb<16\pgf@xb
		\pgf@yb=\dimexpr 1pt*\number\pgf@yb/\number\pgf@xb\relax
		\ifdim\pgf@yb>\moeptikz@t \moeptikz@t=\pgf@yb \fi
	\fi\fi\fi\fi\fi
}

% \moeptikz@polyborder{<outline macros>}
% Border point for an outline made of one or more polygons (one macro each),
% used as \anchorborder code.
\def\moeptikz@polyborder#1{%
	\moeptikz@normalize
	\ifmoeptikz@direction
		\moeptikz@t=-1pt
		\moeptikz@polygons#1\moeptikz@stop
		% no intersection cannot happen for an outline around the center; to be
		% on the safe side use the bounding box then
		\ifdim\moeptikz@t<0pt \moeptikz@t=1pt \fi
		\moeptikz@borderpoint
	\else
		\pgf@x=0pt
		\pgf@y=0pt
	\fi
}
\def\moeptikz@polygons#1{%
	\ifx\moeptikz@stop#1%
	\else
		\expandafter\moeptikz@poly@first#1\moeptikz@stop\moeptikz@stop
		\expandafter\moeptikz@polygons
	\fi
}
\def\moeptikz@poly@first#1#2{%
	\def\moeptikz@x@first{#1}\def\moeptikz@y@first{#2}%
	\def\moeptikz@x@last{#1}\def\moeptikz@y@last{#2}%
	\moeptikz@poly@next
}
\def\moeptikz@poly@next#1#2{%
	\ifx\moeptikz@stop#1%
		% closing edge from the last to the first vertex
		\moeptikz@edge\moeptikz@x@last\moeptikz@y@last
			\moeptikz@x@first\moeptikz@y@first
	\else
		\moeptikz@edge\moeptikz@x@last\moeptikz@y@last{#1}{#2}%
		\def\moeptikz@x@last{#1}\def\moeptikz@y@last{#2}%
		\expandafter\moeptikz@poly@next
	\fi
}

% \moeptikz@capsule<macro>{x1}{y1}{x2}{y2}{r}
% Defines <macro> as the outline of a line from (x1,y1) to (x2,y2) drawn with
% round caps and line width 2r: a polygon with 10 vertices on the two cap
% circles.  Evaluated once when the package is loaded.
\def\moeptikz@capsule#1#2#3#4#5#6{%
	\pgfmathsetmacro\moeptikz@phi{atan2(#5-#3,#4-#2)}%
	\gdef#1{}%
	\moeptikz@capsule@arc#1{#4}{#5}{#6}{90,45,0,-45,-90}%
	\moeptikz@capsule@arc#1{#2}{#3}{#6}{-90,-135,-180,-225,-270}%
}
\def\moeptikz@capsule@arc#1#2#3#4#5{%
	\foreach \moeptikz@a in {#5} {%
		\pgfmathsetmacro\moeptikz@vx{#2+#4*cos(\moeptikz@phi+\moeptikz@a)}%
		\pgfmathsetmacro\moeptikz@vy{#3+#4*sin(\moeptikz@phi+\moeptikz@a)}%
		\xdef#1{#1{\moeptikz@vx}{\moeptikz@vy}}%
	}%
}

% \moeptikz@background<drawing code>
% Code of \backgroundpath.  PGF runs the background path without a scope and
% places the node text afterwards, so every transformation, colour or line width
% set while drawing the shape would also apply to the text (e.g. the hub's
% \pgftransformshift moved its text up).  The shapes draw everything
% themselves, hence the drawing code can safely run in its own scope.
\def\moeptikz@background#1{%
	\pgfscope
	#1%
	\endpgfscope
}

% \moeptikz@textanchor{<border code>}
% Code of the anchor `text': the node text is placed below the shape exactly
% where label=below would put a label, i.e. centered below the border point at
% 270 degrees and separated from it by outer ysep + inner ysep.  Hence
% \node[router] {A}; and \node[router,label=below:A] {}; look the same.
\def\moeptikz@textanchor#1{%
	\pgf@x=0pt
	\pgf@y=-1pt
	#1%
	\advance\pgf@x by -.5\wd\pgfnodeparttextbox
	\advance\pgf@y by -\moeptikz@ysep
	\advance\pgf@y by -\ht\pgfnodeparttextbox
}



%==============================================================================
% server
%==============================================================================
% outline (see \moeptikz@polyborder)
\def\moeptikz@server@outline{%
	{.75}{.4}{-.75}{.4}{-.97}{-.18}{-.99}{-.18}%
	{-.99}{-.4}{.99}{-.4}{.99}{-.18}{.97}{-.18}%
}
\def\moeptikz@server@border{
	\moeptikz@setshading
	\pgfmathparse{.004*\moeptikz@size}\let\moeptikz@lw\pgfmathresult
	\pgfmathparse{.008*\moeptikz@size}\let\moeptikz@lwlarge\pgfmathresult
	\pgfmathparse{.005*\moeptikz@size}\let\moeptikz@arc\pgfmathresult
	\pgfmathparse{.04*sqrt(\moeptikz@size)}\let\moeptikz@fontwidth\pgfmathresult

	% Front
	\pgfsetstrokecolor{black!40}
	\pgfsetfillcolor{black!40}
	\pgfpathrectanglecorners{\northeast \pgf@y=-.2\pgf@y}{\northeast \pgf@x=-\pgf@x \pgf@y=-.4\pgf@y}
	\pgfshadepath{moeptikz@shading}{-25}
	\pgfusepath{}

	\pgfsetstrokecolor{black!40}
	\pgfmoveto{\northeast \pgf@y=-.2\pgf@y}
	\pgflineto{\northeast \pgf@x=-\pgf@x \pgf@y=-.2\pgf@y}
	\pgflineto{\northeast \pgf@x=-.99\pgf@x \pgf@y=-.18\pgf@y}
	\pgflineto{\northeast \pgf@x=.99\pgf@x \pgf@y=-.18\pgf@y}
	\pgfclosepath
	\pgfshadepath{moeptikz@shading}{-25}
	\pgfusepath{}

	% Deckel
	\pgfmoveto{\northeast \pgf@x=.75\pgf@x \pgf@y=.4\pgf@y}
	\pgflineto{\northeast \pgf@x=.97\pgf@x \pgf@y=-.18\pgf@y}
	\pgflineto{\northeast \pgf@x=-.97\pgf@x \pgf@y=-.18\pgf@y}
	\pgflineto{\northeast \pgf@x=-.75\pgf@x \pgf@y=.4\pgf@y}
	\pgfclosepath
	\pgfshadepath{moeptikz@shading}{11.5}
	\pgfusepath{}

	% Amaturen
	\pgfsetstrokecolor{black}
	\pgfsetlinewidth{1.5*\moeptikz@lw}
	\pgfsetcornersarced{\pgfpoint{\moeptikz@arc}{\moeptikz@arc}}
	\pgfmoveto{\northeast \pgf@x=-.9\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=-.9\pgf@x \pgf@y=-.28\pgf@y}
	\pgflineto{\northeast \pgf@x=.9\pgf@x \pgf@y=-.28\pgf@y}
	\pgflineto{\northeast \pgf@x=.9\pgf@x \pgf@y=-.4\pgf@y}
	\pgfusepath{stroke}

	\pgfmoveto{\northeast \pgf@x=-.895\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=-.895\pgf@x \pgf@y=-.28\pgf@y}
	\pgfusepath{stroke}

	\pgfmoveto{\northeast \pgf@x=.895\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=.895\pgf@x \pgf@y=-.28\pgf@y}
	\pgfusepath{stroke}

	\pgfsetlinewidth{2*\moeptikz@lw}
	\pgfmoveto{\northeast \pgf@x=-.44\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=-.44\pgf@x \pgf@y=-.28\pgf@y}
	\pgfusepath{stroke}
	\pgfmoveto{\northeast \pgf@x=-.225\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=-.225\pgf@x \pgf@y=-.28\pgf@y}
	\pgfusepath{stroke}
	\pgfmoveto{\northeast \pgf@x=.225\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=.225\pgf@x \pgf@y=-.28\pgf@y}
	\pgfusepath{stroke}
	\pgfmoveto{\northeast \pgf@x=.44\pgf@x \pgf@y=-.4\pgf@y}
	\pgflineto{\northeast \pgf@x=.44\pgf@x \pgf@y=-.28\pgf@y}
	\pgfusepath{stroke}

	% optical drive
	\pgfsetfillcolor{black}
	\pgfpathrectanglecorners{\northeast \pgf@x=.9\pgf@x \pgf@y=-.22\pgf@y}{\northeast \pgf@x=.34\pgf@x \pgf@y=-.24\pgf@y}
	\pgfusepath{fill}

	% schlitze front oben
	\pgfpathrectanglecorners{\northeast \pgf@x=.3\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.285\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=.26\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.245\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=.22\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.205\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=.18\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.165\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=.14\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.125\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=.10\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.085\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=.06\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=.045\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}

	\pgfpathrectanglecorners{\northeast \pgf@x=-.3\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=-.285\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=-.26\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=-.245\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=-.22\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=-.205\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
	\pgfpathrectanglecorners{\northeast \pgf@x=-.18\pgf@x \pgf@y=-.21\pgf@y}{\northeast \pgf@x=-.165\pgf@x \pgf@y=-.26\pgf@y}
	\pgfusepath{fill}
