	\pgflineto{\northeast \pgf@x=0pt \pgf@y=-.95\pgf@y}
	\pgflineto{\northeast \pgf@y=-.15\pgf@y}
	\pgflineto{\northeast \pgf@y=.15\pgf@y}
	\pgflineto{\northeast \pgf@x=0pt \pgf@y=-.6\pgf@y}
	\pgfclosepath
	\pgfshadepath{moeptikz@shading}{0}
	\pgfusepath{stroke}

	\pgfmoveto{\northeast \pgf@x=0pt \pgf@y=-.6\pgf@y}
	\pgflineto{\northeast \pgf@x=0pt \pgf@y=-.95\pgf@y}
