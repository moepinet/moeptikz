%==============================================================================
% router
%==============================================================================
% The router outline consists of two half ellipses with center (0,+-c), c=.15,
% and radii rx=1 and ry=.75 (in units of half the node size), joined by the
% vertical lines x=+-1, |y|<=c.  For the ray t*(dx,dy) with a=|dy|, b=|dx|
% and max(a,b)=1 the border point is
%   on a vertical line  if a <= c*b:  t = 1
%   on an ellipse       otherwise:    (t*b)^2 + (t*a-c)^2/ry^2 = 1, i.e.
%     t = (a*c + sqrt(a^2*c^2 + (ry^2-c^2)*A))/A   with   A = ry^2*b^2 + a^2
\def\moeptikz@routerborder{%
	\moeptikz@normalize
	\ifmoeptikz@direction
		\pgf@xa=\ifdim\moeptikz@dx<0pt -\fi\moeptikz@dx % b
		\pgf@ya=\ifdim\moeptikz@dy<0pt -\fi\moeptikz@dy % a
		\ifdim\pgf@ya>.15\pgf@xa
			\pgf@xb=\dimexpr.5625\dimexpr\pgf@xa*\number\pgf@xa/65536\relax
				+\pgf@ya*\number\pgf@ya/65536\relax % A
			\pgf@yb=\dimexpr.0225\dimexpr\pgf@ya*\number\pgf@ya/65536\relax
				+.54\pgf@xb\relax
			\edef\moeptikz@tmp{\pgf@sys@tonumber\pgf@yb}%
			\pgfmathsqrt@{\moeptikz@tmp}%
			\pgf@yb=\dimexpr.15\pgf@ya+\pgfmathresult pt\relax
			\moeptikz@t=\dimexpr 1pt*\number\pgf@yb/\number\pgf@xb\relax
		\else
			\moeptikz@t=1pt
		\fi
		\moeptikz@borderpoint
	\else
		\pgf@x=0pt
		\pgf@y=0pt
	\fi
}
\def\moeptikz@router@border{
	\moeptikz@setshading
	\tikzset{get stroke color}
	\pgfsetstrokecolor{black}

	\pgfmathparse{.05*\moeptikz@size}\let\moeptikz@lw\pgfmathresult
	\pgfsetcornersarced{\pgfpoint{0.01pt}{0.01pt}}

	\pgfmathparse{1/2*\moeptikz@size}\let\moeptikz@rx\pgfmathresult
	\pgfmathparse{3/8*\moeptikz@size}\let\moeptikz@ry\pgfmathresult

	% router body
	\pgfsetfillcolor{black!10}
	\pgfpathmoveto{\northeast \pgf@x=-\pgf@x \pgf@y=.15\pgf@y}
	\pgfpathlineto{\northeast \pgf@x=-\pgf@x \pgf@y=-.15\pgf@y}
	\pgfpatharcaxes{180}{360}{\pgfpoint{\moeptikz@rx}{0pt}}{\pgfpoint{0pt}{\moeptikz@ry}}
	\pgfpathlineto{\northeast \pgf@y=.15\pgf@y}
	\pgfclosepath
	\pgfshadepath{moeptikz@shading}{0}
	\pgfusepath{stroke}

	\pgfpathellipse{\northeast \pgf@x=0pt \pgf@y=.15\pgf@y}
		{\northeast \pgf@y=0pt}
		{\northeast \pgf@x=0pt \pgf@y=-.75\pgf@y}
	\pgfshadepath{moeptikz@shading}{0}
	\pgfusepath{stroke}

	\tikzset{replace fill by stroke color/.expand once=\pgfsavedstrokecolor}
	\pgftransformshift{\northeast \pgf@x=0pt \pgf@y=.15\pgf@y}{%
		{
		\pgftransformxslant{1.33}
		\pgftransformyslant{-0.375}
		\pgftransformyscale{.8}
		\pgftransformxscale{1.3}
		\pgfmoveto{\northeast \pgf@x=-\pgf@x \pgf@y=0pt}
		\pgflineto{\northeast \pgf@x=-.5\pgf@x \pgf@y=-.15\pgf@y}
		\pgflineto{\northeast \pgf@x=-.5\pgf@x \pgf@y=-.05\pgf@y}
		\pgflineto{\northeast \pgf@x=.5\pgf@x \pgf@y=-.05\pgf@y}
		\pgflineto{\northeast \pgf@x=.5\pgf@x \pgf@y=-.15\pgf@y}
		\pgflineto{\northeast \pgf@x=\pgf@x \pgf@y=0pt}
		\pgflineto{\northeast \pgf@x=.5\pgf@x \pgf@y=.15\pgf@y}
		\pgflineto{\northeast \pgf@x=.5\pgf@x \pgf@y=.05\pgf@y}
		\pgflineto{\northeast \pgf@x=-.5\pgf@x \pgf@y=.05\pgf@y}
		\pgflineto{\northeast \pgf@x=-.5\pgf@x \pgf@y=.15\pgf@y}
   		\pgfclosepath
		\pgfusepath{fill}
		}

		{
		\pgftransformxslant{1.33}
		\pgftransformyslant{-0.375}
		\pgftransformyscale{0.5}
		\pgftransformxscale{2.2}
		\pgfmoveto{\northeast \pgf@y=-\pgf@y \pgf@x=0pt}
		\pgflineto{\northeast \pgf@y=-.5\pgf@y \pgf@x=-.15\pgf@x}
		\pgflineto{\northeast \pgf@y=-.5\pgf@y \pgf@x=-.05\pgf@x}
		\pgflineto{\northeast \pgf@y=.5\pgf@y \pgf@x=-.05\pgf@x}
		\pgflineto{\northeast \pgf@y=.5\pgf@y \pgf@x=-.15\pgf@x}
		\pgflineto{\northeast \pgf@y=\pgf@y \pgf@x=0pt}
		\pgflineto{\northeast \pgf@y=.5\pgf@y \pgf@x=.15\pgf@x}
		\pgflineto{\northeast \pgf@y=.5\pgf@y \pgf@x=.05\pgf@x}
		\pgflineto{\northeast \pgf@y=-.5\pgf@y \pgf@x=.05\pgf@x}
		\pgflineto{\northeast \pgf@y=-.5\pgf@y \pgf@x=.15\pgf@x}
   		\pgfclosepath
		\pgfusepath{fill}
		}
	}
}
