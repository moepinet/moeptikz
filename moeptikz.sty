	\pgfusepath{stroke,fill}

	% Obere Seite des Couverts (ohne Rand)
	\pgfpathmoveto{\southwest \pgf@y=-.625\pgf@y}
	\pgfpathlineto{\southwest \pgf@x=-\pgf@x \pgf@y=-.625\pgf@y}
	\pgfpathlineto{\southwest \pgf@y=.075\pgf@y \pgf@x=0\pgf@x}
	\pgfclosepath
	\pgfusepath{stroke,fill}
}
