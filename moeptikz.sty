%==============================================================================
% internet
%==============================================================================
% A cloud with a configurable number of puffs, e.g.
%   \node[internet,puffs=7] at (0,0) {Internet};
% Geometry, anchors and border are taken from PGF's cloud shape (library
% shapes.symbols): the cloud grows with its text, which -- unlike the other
% shapes -- is placed in the middle of the cloud; minimum width or minimum
% height enlarge it, aspect sets the ratio of width to height (default 2).
% Only the drawing is done here in the style of the other shapes: the cloud is
% filled with the fill colour, shaded or flat depending on the package option
% shading; the key empty (or fill=none) leaves it unfilled.  The draw colour
% selects the outline (black by default).  TikZ's own fill and draw find an
% empty path, hence the colours affect only the cloud and not the text.
\newif\ifmoeptikz@empty
\def\moeptikz@internet@border{%
	% the path of PGF's cloud
	\csname pgf@sh@bg@cloud\endcsname
	% fill=none switches TikZ's fill mode off.  TikZ collects the mode switches
	% of the node in \tikz@mode and evaluates them only later, hence they are
	% evaluated here (locally, the drawing code runs in its own scope).
	\tikz@mode@filltrue
	\tikz@mode
	\ifmoeptikz@empty
		\tikz@mode@fillfalse
	\fi
	\iftikz@mode@fill
		\moeptikz@setshading
		\pgfshadepath{moeptikz@shading}{0}%
	\fi
	\ifx\tikz@strokecolor\pgfutil@empty
		\pgfsetstrokecolor{black}%
	\else
		\pgfsetstrokecolor{\tikz@strokecolor}%
	\fi
	\pgfusepath{stroke}%
}
\pgfdeclareshape{@internet}{
	\inheritsavedanchors[from=cloud]
	\inheritanchorborder[from=cloud]
	\inheritanchor[from=cloud]{center}
	\inheritanchor[from=cloud]{mid}
	\inheritanchor[from=cloud]{base}
	\inheritanchor[from=cloud]{north}
	\inheritanchor[from=cloud]{south}
	\inheritanchor[from=cloud]{east}
	\inheritanchor[from=cloud]{west}
	\inheritanchor[from=cloud]{north east}
	\inheritanchor[from=cloud]{north west}
	\inheritanchor[from=cloud]{south east}
	\inheritanchor[from=cloud]{south west}
	\backgroundpath{\moeptikz@background\moeptikz@internet@border}
}
% PGF's cloud degenerates if only one of minimum width and minimum height is
% large: the other one follows the text, the ellipse becomes very flat and the
% puffs too large.  Hence both are adjusted to the aspect (width/height) before
% the cloud computes its radii: height >= width/aspect, width >= height*aspect.
\def\moeptikz@internet@size{%
	\pgfmathsetlength\pgf@xa{\pgfkeysvalueof{/pgf/minimum width}}%
	\pgfmathsetlength\pgf@ya{\pgfkeysvalueof{/pgf/minimum height}}%
	\pgf@xb=\pgfshapeaspect\pgf@ya
	\ifdim\pgf@xb>\pgf@xa \pgf@xa=\pgf@xb \fi
	\pgf@yb=\pgfshapeaspectinverse\pgf@xa
	\ifdim\pgf@yb>\pgf@ya \pgf@ya=\pgf@yb \fi
	\edef\moeptikz@tmp{\the\pgf@xa}%
	\pgfkeyslet{/pgf/minimum width}\moeptikz@tmp
	\edef\moeptikz@tmp{\the\pgf@ya}%
	\pgfkeyslet{/pgf/minimum height}\moeptikz@tmp
}
% The saved anchors and macros of a shape are computed by the macro
% \pgf@sh@s@<shape name> when a node is created.  Run the adjustment first.
\expandafter\let\expandafter\moeptikz@internet@cloudsaved
	\csname pgf@sh@s@@internet\endcsname
\expandafter\def\csname pgf@sh@s@@internet\endcsname{%
	\moeptikz@internet@size
	\moeptikz@internet@cloudsaved
}

\tikzset{
internet/.style={
	shape=@internet,
	fill=black,
	puffs=10,
	aspect=2,
	cloud ignores aspect=false
},
% number of puffs of an internet cloud
puffs/.style={/pgf/cloud puffs=#1},
% an internet cloud without filling
empty/.is if=moeptikz@empty,
empty/.default=true
}


%==============================================================================
% fw (firewall)
%==============================================================================
% A brick wall in an oblique view: a front face, a side face receding to the
% back right and a top face.  By default the wall stands upright and shows its
% narrow end (vertical), with the key `horizontal' it lies and shows its long
% side.  Coordinates are in units of half the node size.

% \moeptikz@fw@geometry{<v|h>}{front width}{front height}{angle}{depth}
% Defines the corners of the wall, scaled to fit into the node: front face
% (xa,ya)-(xb,yb), side face up to x=xc, back edges at yc (bottom) and yd
% (top), top face starting at xe.  Evaluated once at load time.
\def\moeptikz@fw@geometry#1#2#3#4#5{%
	\def\moeptikz@fw@set##1##2{%
		\pgfmathsetmacro\moeptikz@tmp{##2}%
		\expandafter\let\csname moeptikz@fw@#1@##1\endcsname\moeptikz@tmp}%
	\pgfmathsetmacro\moeptikz@fw@sc{2/max(#2+#5*cos(#4),#3+#5*sin(#4))}%
	\moeptikz@fw@set{w}{\moeptikz@fw@sc*#2}%
	\moeptikz@fw@set{h}{\moeptikz@fw@sc*#3}%
	\moeptikz@fw@set{dx}{\moeptikz@fw@sc*#5*cos(#4)}%
	\moeptikz@fw@set{dy}{\moeptikz@fw@sc*#5*sin(#4)}%
	\def\moeptikz@fw@g##1{\csname moeptikz@fw@#1@##1\endcsname}%
	\moeptikz@fw@set{xa}{-(\moeptikz@fw@g{w}+\moeptikz@fw@g{dx})/2}%
	\moeptikz@fw@set{ya}{-(\moeptikz@fw@g{h}+\moeptikz@fw@g{dy})/2}%
	\moeptikz@fw@set{xb}{\moeptikz@fw@g{xa}+\moeptikz@fw@g{w}}%
	\moeptikz@fw@set{xc}{\moeptikz@fw@g{xb}+\moeptikz@fw@g{dx}}%
	\moeptikz@fw@set{xe}{\moeptikz@fw@g{xa}+\moeptikz@fw@g{dx}}%
	\moeptikz@fw@set{yb}{\moeptikz@fw@g{ya}+\moeptikz@fw@g{h}}%
	\moeptikz@fw@set{yc}{\moeptikz@fw@g{ya}+\moeptikz@fw@g{dy}}%
	\moeptikz@fw@set{yd}{\moeptikz@fw@g{yb}+\moeptikz@fw@g{dy}}%
	% outline (see \moeptikz@polyborder)
	\expandafter\edef\csname moeptikz@fw@outline@#1\endcsname{%
		{\moeptikz@fw@g{xa}}{\moeptikz@fw@g{ya}}{\moeptikz@fw@g{xb}}{\moeptikz@fw@g{ya}}%
		{\moeptikz@fw@g{xc}}{\moeptikz@fw@g{yc}}{\moeptikz@fw@g{xc}}{\moeptikz@fw@g{yd}}%
		{\moeptikz@fw@g{xe}}{\moeptikz@fw@g{yd}}{\moeptikz@fw@g{xa}}{\moeptikz@fw@g{yb}}}%
}
\moeptikz@fw@geometry{v}{.6}{1.6}{40}{.9}
\moeptikz@fw@geometry{h}{1.9}{.55}{40}{.8}

% \moeptikz@fw@bond<macro>{rows}{bricks per row}
% Defines <macro> as the mortar joints of a running bond in the unit square,
% a list of segments {s1}{t1}{s2}{t2}.  Evaluated once at load time.
\def\moeptikz@fw@bond#1#2#3{%
	\gdef#1{}%
	\pgfmathtruncatemacro\moeptikz@fw@rm{#2-1}%
	\foreach \moeptikz@fw@r in {1,...,\moeptikz@fw@rm} {%
		\pgfmathsetmacro\moeptikz@fw@t{\moeptikz@fw@r/#2}%
		\xdef#1{#1{0}{\moeptikz@fw@t}{1}{\moeptikz@fw@t}}%
	}%
	\foreach \moeptikz@fw@r in {0,...,\moeptikz@fw@rm} {%
		\foreach \moeptikz@fw@b in {1,...,#3} {%
			\pgfmathsetmacro\moeptikz@fw@s
				{(\moeptikz@fw@b-.5*mod(\moeptikz@fw@r,2))/#3}%
			\ifdim\moeptikz@fw@s pt>.001pt \ifdim\moeptikz@fw@s pt<.999pt
				\pgfmathsetmacro\moeptikz@fw@ta{\moeptikz@fw@r/#2}%
				\pgfmathsetmacro\moeptikz@fw@tb{(\moeptikz@fw@r+1)/#2}%
				\xdef#1{#1{\moeptikz@fw@s}{\moeptikz@fw@ta}%
					{\moeptikz@fw@s}{\moeptikz@fw@tb}}%
			\fi\fi
		}%
	}%
}
% joints of the front, side and top faces (s along the first, t along the
% second edge of the face)
\moeptikz@fw@bond\moeptikz@fw@v@front{6}{2}
\moeptikz@fw@bond\moeptikz@fw@v@side{6}{3}
\def\moeptikz@fw@v@top{%
	{0}{.33333}{1}{.33333}{0}{.66667}{1}{.66667}%
	{.5}{0}{.5}{.33333}{.5}{.66667}{.5}{1}}
\moeptikz@fw@bond\moeptikz@fw@h@front{2}{5}
\moeptikz@fw@bond\moeptikz@fw@h@side{2}{2}
\moeptikz@fw@bond\moeptikz@fw@h@top{3}{5}

% A face is the parallelogram o + s*u + t*v, 0 <= s,t <= 1.
% \moeptikz@fw@face{ox}{oy}{ux}{uy}{vx}{vy} selects it (units of half the node
% size), \moeptikz@fw@pt{s}{t} is a point on it, \moeptikz@fw@joints<list>
% adds the segments of a joint list to the path.
\newdimen\moeptikz@fw@unit
\def\moeptikz@fw@face#1#2#3#4#5#6{%
	\edef\moeptikz@fw@ox{\the\dimexpr#1\moeptikz@fw@unit\relax}%
	\edef\moeptikz@fw@oy{\the\dimexpr#2\moeptikz@fw@unit\relax}%
	\edef\moeptikz@fw@ux{\the\dimexpr#3\moeptikz@fw@unit\relax}%
	\edef\moeptikz@fw@uy{\the\dimexpr#4\moeptikz@fw@unit\relax}%
	\edef\moeptikz@fw@vx{\the\dimexpr#5\moeptikz@fw@unit\relax}%
	\edef\moeptikz@fw@vy{\the\dimexpr#6\moeptikz@fw@unit\relax}%
}
\def\moeptikz@fw@pt#1#2{%
	\pgfqpoint
		{\dimexpr\moeptikz@fw@ox+#1\dimexpr\moeptikz@fw@ux\relax
			+#2\dimexpr\moeptikz@fw@vx\relax\relax}%
		{\dimexpr\moeptikz@fw@oy+#1\dimexpr\moeptikz@fw@uy\relax
			+#2\dimexpr\moeptikz@fw@vy\relax\relax}%
}
\def\moeptikz@fw@joints#1{%
	\expandafter\moeptikz@fw@seg#1\moeptikz@stop\moeptikz@stop
		\moeptikz@stop\moeptikz@stop
}
\def\moeptikz@fw@seg#1#2#3#4{%
	\ifx\moeptikz@stop#1%
	\else
		\pgfpathmoveto{\moeptikz@fw@pt{#1}{#2}}%
		\pgfpathlineto{\moeptikz@fw@pt{#3}{#4}}%
		\expandafter\moeptikz@fw@seg
	\fi
}
% \moeptikz@fw@paint{fill code}{joint colour}{joint list}: fills the current
% face and draws its joints
\def\moeptikz@fw@paint#1#2#3{%
	\pgfpathmoveto{\moeptikz@fw@pt{0}{0}}%
	\pgfpathlineto{\moeptikz@fw@pt{1}{0}}%
	\pgfpathlineto{\moeptikz@fw@pt{1}{1}}%
	\pgfpathlineto{\moeptikz@fw@pt{0}{1}}%
	\pgfpathclose
	#1%
	\pgfsetstrokecolor{#2}%
	\expandafter\moeptikz@fw@joints\csname moeptikz@fw@\moeptikz@fw@orient @#3\endcsname
	\pgfusepath{stroke}%
}
% coordinates of the current orientation (saved macro \moeptikz@fw@orient)
\def\moeptikz@fw@c#1{\csname moeptikz@fw@\moeptikz@fw@orient @#1\endcsname}
\def\moeptikz@fw@p#1#2{%
	\pgfqpoint{\moeptikz@fw@c{#1}\moeptikz@fw@unit}{\moeptikz@fw@c{#2}\moeptikz@fw@unit}}

\def\moeptikz@fw@border{%
	\moeptikz@setshading
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\pgfsetroundjoin
	\pgfmathsetlength\pgf@xa{.03*\moeptikz@size}%
	\pgfsetlinewidth{\pgf@xa}%
	% front face: shaded like the other shapes
	\moeptikz@fw@face{\moeptikz@fw@c{xa}}{\moeptikz@fw@c{ya}}%
		{\moeptikz@fw@c{w}}{0}{0}{\moeptikz@fw@c{h}}%
	\moeptikz@fw@paint{\pgfshadepath{moeptikz@shadingnuc}{0}\pgfusepath{}}%
		{white!90!black}{front}%
	% side face receding to the back right: darker
	\moeptikz@fw@face{\moeptikz@fw@c{xb}}{\moeptikz@fw@c{ya}}%
		{\moeptikz@fw@c{dx}}{\moeptikz@fw@c{dy}}{0}{\moeptikz@fw@c{h}}%
	\moeptikz@fw@paint{\pgfsetfillcolor{moeptikz@fill!85!black}\pgfusepath{fill}}%
		{white!75!black}{side}%
	% top face: darkest
	\moeptikz@fw@face{\moeptikz@fw@c{xa}}{\moeptikz@fw@c{yb}}%
		{\moeptikz@fw@c{w}}{0}{\moeptikz@fw@c{dx}}{\moeptikz@fw@c{dy}}%
	\moeptikz@fw@paint{\pgfsetfillcolor{moeptikz@fill!70!black}\pgfusepath{fill}}%
		{white!65!black}{top}%
	% inner edges
	\pgfsetstrokecolor{black}%
	\pgfmathsetlength\pgf@xa{.015*\moeptikz@size}%
	\pgfsetlinewidth{\pgf@xa}%
	\pgfpathmoveto{\moeptikz@fw@p{xa}{yb}}%
	\pgfpathlineto{\moeptikz@fw@p{xb}{yb}}%
	\pgfpathlineto{\moeptikz@fw@p{xb}{ya}}%
	\pgfpathmoveto{\moeptikz@fw@p{xb}{yb}}%
	\pgfpathlineto{\moeptikz@fw@p{xc}{yd}}%
	\pgfusepath{stroke}%
	% outline
	\pgfmathsetlength\pgf@xa{.025*\moeptikz@size}%
	\pgfsetlinewidth{\pgf@xa}%
	\pgfpathmoveto{\moeptikz@fw@p{xa}{ya}}%
	\pgfpathlineto{\moeptikz@fw@p{xb}{ya}}%
	\pgfpathlineto{\moeptikz@fw@p{xc}{yc}}%
	\pgfpathlineto{\moeptikz@fw@p{xc}{yd}}%
	\pgfpathlineto{\moeptikz@fw@p{xe}{yd}}%
	\pgfpathlineto{\moeptikz@fw@p{xa}{yb}}%
	\pgfpathclose
	\pgfusepath{stroke}%
}
% border of the current orientation
\def\moeptikz@fw@anchorborder{%
	\expandafter\moeptikz@polyborder\expandafter
		{\csname moeptikz@fw@outline@\moeptikz@fw@orient\endcsname}%
}
\newif\ifmoeptikz@horizontal
\pgfdeclareshape{@fw}{
	\moeptikz@savedmacros
	% orientation: v (upright) or h (horizontal), see key `horizontal'
	\savedmacro\moeptikz@fw@orient{%
		\ifmoeptikz@horizontal
			\def\moeptikz@fw@orient{h}%
		\else
			\def\moeptikz@fw@orient{v}%
		\fi
	}
	\anchor{center}{\pgfpointorigin}
	\anchorborder{\moeptikz@fw@anchorborder}
	\backgroundpath{\moeptikz@background\moeptikz@fw@border}
	% compass anchors on the outline
	\anchor{north}{\pgf@x=0pt\pgf@y=1pt\moeptikz@fw@anchorborder}
	\anchor{south}{\pgf@x=0pt\pgf@y=-1pt\moeptikz@fw@anchorborder}
	\anchor{east}{\pgf@x=1pt\pgf@y=0pt\moeptikz@fw@anchorborder}
	\anchor{west}{\pgf@x=-1pt\pgf@y=0pt\moeptikz@fw@anchorborder}
	\anchor{north east}{\pgf@x=1pt\pgf@y=1pt\moeptikz@fw@anchorborder}
	\anchor{north west}{\pgf@x=-1pt\pgf@y=1pt\moeptikz@fw@anchorborder}
	\anchor{south east}{\pgf@x=1pt\pgf@y=-1pt\moeptikz@fw@anchorborder}
	\anchor{south west}{\pgf@x=-1pt\pgf@y=-1pt\moeptikz@fw@anchorborder}
	\anchor{text}{\moeptikz@textanchor{\moeptikz@fw@anchorborder}}
}

\tikzset{
fw/.style 2 args={
	shape=@fw,
	minimum size=#1,
	fill=#2
},
fw/.default={1cm}{red!50!black},
% a lying firewall (fw) showing its long side
