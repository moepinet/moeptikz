\def\moeptikz@nb@tx{0}
\def\moeptikz@nb@ty{0}
\def\moeptikz@nb@tz{0}
\def\moeptikz@nb@vx{10}
\def\moeptikz@nb@vy{15}
\def\moeptikz@nb@vz{-10}
\pgfmathparse{cos(-\moeptikz@nb@tx)}
\edef\moeptikz@nb@cx{\pgfmathresult}
\pgfmathparse{cos(-\moeptikz@nb@ty)}
\edef\moeptikz@nb@cy{\pgfmathresult}
\pgfmathparse{cos(-\moeptikz@nb@tz)}
\edef\moeptikz@nb@cz{\pgfmathresult}
\pgfmathparse{sin(-\moeptikz@nb@tx)}
\edef\moeptikz@nb@sx{\pgfmathresult}
\pgfmathparse{sin(-\moeptikz@nb@ty)}
\edef\moeptikz@nb@sy{\pgfmathresult}
\pgfmathparse{sin(-\moeptikz@nb@tz)}
\edef\moeptikz@nb@sz{\pgfmathresult}
\newcommand{\moeptikz@transform}[3]{%
	\pgfmathparse{\moeptikz@nb@cy*(\moeptikz@nb@sz*(#2-\moeptikz@nb@vy)+\moeptikz@nb@cz*(#1-\moeptikz@nb@vx))-\moeptikz@nb@sy*(#3-\moeptikz@nb@vz)}
	\edef\moeptikz@nb@dx{\pgfmathresult}
	\pgfmathparse{\moeptikz@nb@sx*(\moeptikz@nb@cy*(#3-\moeptikz@nb@vz)+\moeptikz@nb@sy*(\moeptikz@nb@sz*(#2-\moeptikz@nb@vy)+\moeptikz@nb@cz*(#1-\moeptikz@nb@vx)))+\moeptikz@nb@cx*(\moeptikz@nb@cz*(#2-\moeptikz@nb@vy)-\moeptikz@nb@sz*(#1-\moeptikz@nb@vx)}
	\edef\moeptikz@nb@dy{\pgfmathresult}
	\pgfmathparse{\moeptikz@nb@cx*(\moeptikz@nb@cy*(#3-\moeptikz@nb@vz)+\moeptikz@nb@sy*(\moeptikz@nb@sz*(#2-\moeptikz@nb@vy)+\moeptikz@nb@cz*(#1-\moeptikz@nb@vx)))-\moeptikz@nb@sx*(\moeptikz@nb@cz*(#2-\moeptikz@nb@vy)-\moeptikz@nb@sz*(#1-\moeptikz@nb@vx))}
	\edef\moeptikz@nb@dz{\pgfmathresult}
	\pgfmathparse{\moeptikz@nb@dx/\moeptikz@nb@dz}
	\pgf@x=\pgfmathresult\pgf@x
	\pgfmathparse{\moeptikz@nb@dy/\moeptikz@nb@dz}
	\pgf@y=\pgfmathresult\pgf@y
}
\newcommand{\moeptikz@transforma}[3]{%
	\pgfmathparse{\moeptikz@nb@cy*(\moeptikz@nb@sz*(#2-\moeptikz@nb@vy)+\moeptikz@nb@cz*(#1-\moeptikz@nb@vx))-\moeptikz@nb@sy*(#3-\moeptikz@nb@vz)}
	\edef\moeptikz@nb@dx{\pgfmathresult}
	\pgfmathparse{\moeptikz@nb@sx*(\moeptikz@nb@cy*(#3-\moeptikz@nb@vz)+\moeptikz@nb@sy*(\moeptikz@nb@sz*(#2-\moeptikz@nb@vy)+\moeptikz@nb@cz*(#1-\moeptikz@nb@vx)))+\moeptikz@nb@cx*(\moeptikz@nb@cz*(#2-\moeptikz@nb@vy)-\moeptikz@nb@sz*(#1-\moeptikz@nb@vx)}
	\edef\moeptikz@nb@dy{\pgfmathresult}
	\pgfmathparse{\moeptikz@nb@cx*(\moeptikz@nb@cy*(#3-\moeptikz@nb@vz)+\moeptikz@nb@sy*(\moeptikz@nb@sz*(#2-\moeptikz@nb@vy)+\moeptikz@nb@cz*(#1-\moeptikz@nb@vx)))-\moeptikz@nb@sx*(\moeptikz@nb@cz*(#2-\moeptikz@nb@vy)-\moeptikz@nb@sz*(#1-\moeptikz@nb@vx))}
	\edef\moeptikz@nb@dz{\pgfmathresult}
	\pgfmathparse{\moeptikz@nb@dx/\moeptikz@nb@dz}
	\pgf@xa=\pgfmathresult\pgf@xa
	\pgfmathparse{\moeptikz@nb@dy/\moeptikz@nb@dz}
	\pgf@ya=\pgfmathresult\pgf@ya
}

\newcommand\moeptikz@point[3]{%
	\northeast
	\moeptikz@transform{#1}{#2}{#3}
	\pgfpoint{\pgf@x}{\pgf@y}
}

% The notebook is drawn in a perspective projection (see \moeptikz@transform),
% scaled by 10 and shifted by (vxvz,vyvz) as in \moeptikz@notebook@border.
% Its outline consists of the projected corners of screen and keyboard and is
% computed once when the package is loaded.
\pgfmathparse{-\moeptikz@nb@vx/\moeptikz@nb@vz-1/(\moeptikz@nb@vx*\moeptikz@nb@vz)}
\let\moeptikz@nb@shiftx\pgfmathresult
\pgfmathparse{-\moeptikz@nb@vy/\moeptikz@nb@vz}
\let\moeptikz@nb@shifty\pgfmathresult
\def\moeptikz@notebook@outline{}
\def\moeptikz@nb@vertex#1#2#3{%
	\pgf@x=1pt
	\pgf@y=1pt
	\moeptikz@transform{#1}{#2}{#3}%
	\pgf@x=10\dimexpr\pgf@x+\moeptikz@nb@shiftx pt\relax
	\pgf@y=10\dimexpr\pgf@y+\moeptikz@nb@shifty pt\relax
	\edef\moeptikz@notebook@outline{\moeptikz@notebook@outline
		{\pgf@sys@tonumber\pgf@x}{\pgf@sys@tonumber\pgf@y}}%
}
\moeptikz@nb@vertex{-1.0}{1.1}{-.1}
\moeptikz@nb@vertex{-1.0}{0}{-.1}
\moeptikz@nb@vertex{-1.0}{0}{-.5}
\moeptikz@nb@vertex{1.0}{0}{-.5}
\moeptikz@nb@vertex{1.0}{0}{-.1}
\moeptikz@nb@vertex{1.0}{1.1}{-.1}

\def\moeptikz@notebook@border{
	\moeptikz@setshading
	\pgfmathparse{.0025*\moeptikz@size}\let\moeptikz@lw\pgfmathresult
	\pgfmathparse{.01*\moeptikz@size}\let\moeptikz@lwlarge\pgfmathresult
	\pgfmathparse{.01*\moeptikz@size}\let\moeptikz@arc\pgfmathresult
	\pgfmathparse{.004*\moeptikz@size}\let\moeptikz@arcsmall\pgfmathresult
	\pgfmathparse{.04*sqrt(\moeptikz@size)}\let\moeptikz@fontwidth\pgfmathresult
	\pgfgettransform\moeptikz@nb@savedtransform

	\pgfsetcornersarced{\pgfpoint{\moeptikz@arc}{\moeptikz@arc}}
	\pgfsetlinewidth{\moeptikz@lw}

%	\pgfmoveto{\moeptikz@point{-1}{-1}}
%	\pgflineto{\moeptikz@point{1}{-1}}
%	\pgflineto{\moeptikz@point{1}{1}}
%	\pgflineto{\moeptikz@point{-1}{1}}
%	\pgfclosepath
%	\pgfusepath{fill}

	\edef\moeptikz@scale{10}
	\pgfmathparse{0.1*\moeptikz@scale*\moeptikz@nb@vx}
	\edef\moeptikz@xscale{\pgfmathresult}
	\pgfmathparse{0.1*\moeptikz@scale*\moeptikz@nb@vy}
	\edef\moeptikz@yscale{\pgfmathresult}
	\pgftransformxscale{\moeptikz@scale}
	\pgftransformyscale{\moeptikz@scale}
	\pgfmathparse{-\moeptikz@nb@vx/\moeptikz@nb@vz-1/(\moeptikz@nb@vx*\moeptikz@nb@vz)}
	\edef\moeptikz@vxvz{\pgfmathresult}
	\pgfmathparse{-\moeptikz@nb@vy/\moeptikz@nb@vz}
	\edef\moeptikz@vyvz{\pgfmathresult}
	\pgftransformshift{\northeast \pgfpoint{\moeptikz@vxvz\pgf@x}{\moeptikz@vyvz\pgf@y}}
	\pgfsetstrokecolor{red}

	% Kante vorne (simuliert durch darunterliegende Flaeche)
	\pgfsetfillcolor{black!40}
	\pgfmoveto{\moeptikz@point{-1.0}{-.05}{-.1}}
	\pgflineto{\moeptikz@point{1.01}{-.05}{-.1}}
	\pgflineto{\moeptikz@point{1.01}{-.01}{-.5}}
	\pgflineto{\moeptikz@point{-1.0}{-.01}{-.5}}
	\pgfclosepath
	\pgfusepath{fill}

	% Kante rechts
	\pgfsetfillcolor{black!40}
	\pgfmoveto{\moeptikz@point{1.01}{-0.01}{-.5}}
	\pgflineto{\moeptikz@point{1.01}{-.05}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.5}}
	\pgfclosepath
	\pgfusepath{fill}

	% Tastaturflaeche
	\pgfsetfillcolor{black!20}
	\pgfsetstrokecolor{black!30}
	\pgfmoveto{\moeptikz@point{-1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.5}}
	\pgflineto{\moeptikz@point{-1.0}{0}{-.5}}
	\pgfclosepath
	\pgfshadepath{moeptikz@shading}{180}
	\pgfsetfillcolor{black!20}
	\pgfsetstrokecolor{black!30}
	\pgfmoveto{\moeptikz@point{-1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.5}}
	\pgflineto{\moeptikz@point{-1.0}{0}{-.5}}
	\pgfclosepath
	\pgfusepath{stroke}

	% 3D Effekt Bildschirm
	\pgfsetfillcolor{black!40}
	\pgfmoveto{\moeptikz@point{-1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.005}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.005}{1.1}{-.1}}
	\pgflineto{\moeptikz@point{-1.0}{1.1}{-.1}}
	\pgfclosepath
	\pgfusepath{fill}

	% Schwarzer Bildschirmrahmen
	\pgfsetfillcolor{black}
	\pgfmoveto{\moeptikz@point{-1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{0}{-.1}}
	\pgflineto{\moeptikz@point{1.0}{1.1}{-.1}}
	\pgflineto{\moeptikz@point{-1.0}{1.1}{-.1}}
	\pgfclosepath
	\pgfusepath{fill}

	% Displayflaeche
	\pgfsetfillcolor{black!90}
	\pgfmoveto{\moeptikz@point{-.95}{0.055}{-.1}}
	\pgflineto{\moeptikz@point{.95}{0.055}{-.1}}
	\pgflineto{\moeptikz@point{.95}{1.045}{-.1}}
	\pgflineto{\moeptikz@point{-.95}{1.045}{-.1}}
	\pgfclosepath
	\pgfshadepath{moeptikz@shadingnuc}{180}
	\pgfusepath{}

	% Trackpad
	\pgfsetfillcolor{black!30}
	\pgfmoveto{\moeptikz@point{-.4}{0}{-.33}}
	\pgflineto{\moeptikz@point{.4}{0}{-.33}}
	\pgflineto{\moeptikz@point{.4}{0}{-.49}}
	\pgflineto{\moeptikz@point{-.4}{0}{-.49}}
	\pgfclosepath
	\pgfusepath{stroke,fill}

	% Keyboard
	\pgfsetcornersarced{\pgfpoint{\moeptikz@arcsmall}{\moeptikz@arcsmall}}
	\foreach \x in {1,2,...,14} {%
		\pgfsetfillcolor{black}
		\pgfmathparse{-1.025+\x*0.13}
		\pgfmoveto{\moeptikz@point{\pgfmathresult}{0}{-.12}}
		\pgfmathparse{-1.025+\x*0.13+.1}
		\pgflineto{\moeptikz@point{\pgfmathresult}{0}{-.12}}
		\pgflineto{\moeptikz@point{\pgfmathresult}{0}{-.14}}
		\pgfmathparse{-1.025+\x*0.13}
		\pgflineto{\moeptikz@point{\pgfmathresult}{0}{-.14}}
		\pgfclosepath
		\pgfusepath{fill}
	}
	\foreach \x in {1,2,...,14} {%
		\foreach \z in {0,1,...,4} {%
			\pgfsetfillcolor{black}
			\pgfmathparse{-1.025+\x*0.13}
			\edef\moeptikz@tmpx{\pgfmathresult}
			\pgfmathparse{-.15-\z*0.035}
			\edef\moeptikz@tmpz{\pgfmathresult}
			\pgfmoveto{\moeptikz@point{\moeptikz@tmpx}{0}{\moeptikz@tmpz}}

			\pgfmathparse{-1.025+\x*0.13+0.1}
			\edef\moeptikz@tmpx{\pgfmathresult}
			\pgflineto{\moeptikz@point{\moeptikz@tmpx}{0}{\moeptikz@tmpz}}

			\pgfmathparse{-.15-\z*0.035-0.025}
			\edef\moeptikz@tmpz{\pgfmathresult}
			\pgflineto{\moeptikz@point{\moeptikz@tmpx}{0}{\moeptikz@tmpz}}

			\pgfmathparse{-1.025+\x*0.13}
			\edef\moeptikz@tmpx{\pgfmathresult}
			\pgflineto{\moeptikz@point{\moeptikz@tmpx}{0}{\moeptikz@tmpz}}

			\pgfclosepath
			\pgfusepath{fill}
		}
	}

	%\pgfmoveto{\moeptikz@point{-1.0}{1.1}{-.1}}
	%\pgflineto{\moeptikz@point{-1.0}{0}{-.1}}
	%\pgflineto{\moeptikz@point{-1.0}{0}{-.5}}
	%\pgflineto{\moeptikz@point{1.0}{0}{-.5}}
	%\pgflineto{\moeptikz@point{1.0}{0}{-.1}}
	%\pgflineto{\moeptikz@point{1.0}{1.1}{-.1}}
	%\pgfclosepath
	%\pgfusepath{stroke}
	\pgfsettransform{\moeptikz@nb@savedtransform}
}
