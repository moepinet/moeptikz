	\pgflineto{\northeast \pgf@x=-\pgf@x \pgf@y=.15\pgf@y}
	\pgfclosepath
	\pgfshadepath{moeptikz@shading}{0}
	\pgfusepath{stroke}

	\pgfmoveto{\northeast \pgf@x=-\pgf@x \pgf@y=.15\pgf@y}
