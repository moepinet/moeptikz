%==============================================================================
% fwrouter
%==============================================================================
% A router with a firewall on top: the upper half of the cylinder wall and the
% top are bricks in the colour `fw color' (default red!50!black), the lower
% half and the arrows are drawn as for the router (fill and draw colour).
% Size, anchors and border are those of the router.
\tikzset{fw color/.initial={red!50!black}}
\def\moeptikz@fwrouter@border{%
	\moeptikz@router@setup
	\moeptikz@router@body
	% from now on shade with the wall colour
	\pgfkeysgetvalue{/tikz/fw color}\moeptikz@fwcolor
	\let\tikz@fillcolor\moeptikz@fwcolor
	\moeptikz@setshading
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\pgfmathsetlength\pgf@xa{.02*\moeptikz@size}%
	\edef\moeptikz@mortar{\the\pgf@xa}%
	% upper half of the cylinder wall, between the front arcs of the ellipses
	% at height 0 and .15
	\pgfpathmoveto{\northeast \pgf@x=-\pgf@x \pgf@y=0pt}
	\pgfpatharcaxes{180}{360}{\pgfpoint{\moeptikz@rx}{0pt}}{\pgfpoint{0pt}{\moeptikz@ry}}
	\pgfpathlineto{\northeast \pgf@y=.15\pgf@y}
	\pgfpatharcaxes{0}{-180}{\pgfpoint{\moeptikz@rx}{0pt}}{\pgfpoint{0pt}{\moeptikz@ry}}
	\pgfpathclose
	\pgfshadepath{moeptikz@shadingnuc}{0}
	\pgfusepath{}
	% vertical joints of the single course (own scope: the PDF keeps the
	% stroke colour after a TeX group)
	\pgfscope
		\pgfsetlinewidth{\moeptikz@mortar}%
		\pgfsetstrokecolor{white!75!black}%
		\foreach \moeptikz@a in {202.5,225,...,337.5} {%
			\pgfpathmoveto{\pgfpointadd{\pgfpointpolar{\moeptikz@a}
				{\moeptikz@fw@unit and .75\moeptikz@fw@unit}}{\pgfpointorigin}}%
			\pgfpathlineto{\pgfpointadd{\pgfpointpolar{\moeptikz@a}
				{\moeptikz@fw@unit and .75\moeptikz@fw@unit}}
				{\pgfqpoint{0pt}{.15\moeptikz@fw@unit}}}%
		}%
		\pgfusepath{stroke}%
	\endpgfscope
	\pgfpathmoveto{\northeast \pgf@x=-\pgf@x \pgf@y=0pt}
	\pgfpatharcaxes{180}{360}{\pgfpoint{\moeptikz@rx}{0pt}}{\pgfpoint{0pt}{\moeptikz@ry}}
	\pgfpathlineto{\northeast \pgf@y=.15\pgf@y}
	\pgfusepath{stroke}
	% top: running bond in the plane of the top circle, rotated by 30 degrees
	% and clipped to the top ellipse
	\pgfpathellipse{\northeast \pgf@x=0pt \pgf@y=.15\pgf@y}
		{\northeast \pgf@y=0pt}
		{\northeast \pgf@x=0pt \pgf@y=-.75\pgf@y}
	\pgfshadepath{moeptikz@shadingnuc}{0}
	\pgfusepath{}
	\pgfscope
		\pgfpathellipse{\northeast \pgf@x=0pt \pgf@y=.15\pgf@y}
			{\northeast \pgf@y=0pt}
			{\northeast \pgf@x=0pt \pgf@y=-.75\pgf@y}
		\pgfusepath{clip}
		\pgftransformshift{\pgfqpoint{0pt}{.15\moeptikz@fw@unit}}
		\pgftransformyscale{.75}
		\pgftransformrotate{30}
		\pgfsetlinewidth{\moeptikz@mortar}
		\pgfsetstrokecolor{white!75!black}
		% courses of height .3, bricks of length .6 (units of half the size)
		\foreach \moeptikz@r in {-4,...,4} {%
			\pgfmathsetmacro\moeptikz@ya{.3*\moeptikz@r}%
			\pgfmathsetmacro\moeptikz@yb{.3*\moeptikz@r+.3}%
			\pgfpathmoveto{\pgfqpoint{-1.2\moeptikz@fw@unit}{\moeptikz@ya\moeptikz@fw@unit}}%
			\pgfpathlineto{\pgfqpoint{1.2\moeptikz@fw@unit}{\moeptikz@ya\moeptikz@fw@unit}}%
			\foreach \moeptikz@b in {-2,...,2} {%
				\pgfmathsetmacro\moeptikz@xa{.6*\moeptikz@b+.3*mod(\moeptikz@r+4,2)}%
				\pgfpathmoveto{\pgfqpoint{\moeptikz@xa\moeptikz@fw@unit}{\moeptikz@ya\moeptikz@fw@unit}}%
				\pgfpathlineto{\pgfqpoint{\moeptikz@xa\moeptikz@fw@unit}{\moeptikz@yb\moeptikz@fw@unit}}%
			}%
		}%
		\pgfusepath{stroke}
	\endpgfscope
	\pgfpathellipse{\northeast \pgf@x=0pt \pgf@y=.15\pgf@y}
		{\northeast \pgf@y=0pt}
		{\northeast \pgf@x=0pt \pgf@y=-.75\pgf@y}
	\pgfusepath{stroke}
	\moeptikz@router@arrows
}
\pgfdeclareshape{@fwrouter}{
	\inheritsavedanchors[from=@router]
	\inheritanchorborder[from=@router]
	\inheritanchor[from=@router]{center}
	\inheritanchor[from=@router]{north}
	\inheritanchor[from=@router]{east}
	\inheritanchor[from=@router]{south}
	\inheritanchor[from=@router]{west}
	\inheritanchor[from=@router]{north east}
	\inheritanchor[from=@router]{north west}
	\inheritanchor[from=@router]{south east}
	\inheritanchor[from=@router]{south west}
	\inheritanchor[from=@router]{text}
	\backgroundpath{\moeptikz@background\moeptikz@fwrouter@border}
}

\tikzset{
fwrouter/.style 2 args={
	shape=@fwrouter,
	minimum size=#1,
	fill=#2
},
fwrouter/.default={1cm}{black}
}


%==============================================================================
% mlswitch
%==============================================================================
% A multilayer switch: the body of the switch with the arrows of the router on
% its lid, scaled by .7 around the centre of the lid so that they stay on the
% lid, and two arrows pointing apart on each of the two front faces.  Size,
% anchors and border are those of the switch.

% \moeptikz@mlswitch@arrow{s0}{s1}{s2}{t}{shaft}{head}
% Arrow in the unit square of a face from s0 via the base of the head at s1
% to the tip at s2, at height t, half widths of shaft and head (units of half
% the node size, \moeptikz@fw@unit).
\def\moeptikz@mlswitch@arrow#1#2#3#4#5#6{%
	\pgfpathmoveto{\pgfqpoint{#1\moeptikz@fw@unit}
		{\dimexpr#4\moeptikz@fw@unit-#5\moeptikz@fw@unit\relax}}%
	\pgfpathlineto{\pgfqpoint{#2\moeptikz@fw@unit}
		{\dimexpr#4\moeptikz@fw@unit-#5\moeptikz@fw@unit\relax}}%
	\pgfpathlineto{\pgfqpoint{#2\moeptikz@fw@unit}
		{\dimexpr#4\moeptikz@fw@unit-#6\moeptikz@fw@unit\relax}}%
	\pgfpathlineto{\pgfqpoint{#3\moeptikz@fw@unit}{#4\moeptikz@fw@unit}}%
	\pgfpathlineto{\pgfqpoint{#2\moeptikz@fw@unit}
		{\dimexpr#4\moeptikz@fw@unit+#6\moeptikz@fw@unit\relax}}%
	\pgfpathlineto{\pgfqpoint{#2\moeptikz@fw@unit}
		{\dimexpr#4\moeptikz@fw@unit+#5\moeptikz@fw@unit\relax}}%
	\pgfpathlineto{\pgfqpoint{#1\moeptikz@fw@unit}
		{\dimexpr#4\moeptikz@fw@unit+#5\moeptikz@fw@unit\relax}}%
	\pgfpathclose
}
% the two arrows of a front face
\def\moeptikz@mlswitch@sidearrows{%
	\moeptikz@mlswitch@arrow{.42}{.25}{.1}{.5}{.12}{.3}%
	\moeptikz@mlswitch@arrow{.58}{.75}{.9}{.5}{.12}{.3}%
	\pgfusepath{fill}%
}
\def\moeptikz@mlswitch@border{%
	\moeptikz@switch@body
	% arrows of the router on the lid (own scope: the transformations must
	% not affect the faces)
	\pgfscope
		\pgftransformshift{\northeast \pgf@x=0pt \pgf@y=.15\pgf@y}%
		\pgftransformscale{.7}%
		\pgftransformshift{\northeast \pgf@x=0pt \pgf@y=-.15\pgf@y}%
		\moeptikz@router@arrows
	\endpgfscope
	% arrows on the front faces in the draw colour; each face is mapped onto
	% the unit square: left face from (-1,-.15) along (1,-.8) and (0,.3),
	% right face from (0,-.95) along (1,.8) and (0,.3)
	\tikzset{replace fill by stroke color/.expand once=\pgfsavedstrokecolor}%
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\pgfscope
		\pgftransformcm{1}{-.8}{0}{.3}%
			{\pgfqpoint{-\moeptikz@fw@unit}{-.15\moeptikz@fw@unit}}%
		\moeptikz@mlswitch@sidearrows
	\endpgfscope
	\pgfscope
		\pgftransformcm{1}{.8}{0}{.3}{\pgfqpoint{0pt}{-.95\moeptikz@fw@unit}}%
		\moeptikz@mlswitch@sidearrows
	\endpgfscope
}
\pgfdeclareshape{@mlswitch}{
	\inheritsavedanchors[from=@switch]
	\inheritanchorborder[from=@switch]
	\inheritanchor[from=@switch]{center}
	\inheritanchor[from=@switch]{north}
	\inheritanchor[from=@switch]{east}
	\inheritanchor[from=@switch]{south}
	\inheritanchor[from=@switch]{west}
	\inheritanchor[from=@switch]{north east}
	\inheritanchor[from=@switch]{north west}
	\inheritanchor[from=@switch]{south east}
	\inheritanchor[from=@switch]{south west}
	\inheritanchor[from=@switch]{text}
	\backgroundpath{\moeptikz@background\moeptikz@mlswitch@border}
}

\tikzset{
mlswitch/.style 2 args={
	shape=@mlswitch,
	minimum size=#1,
	fill=#2
},
mlswitch/.default={1cm}{black}
}

%==============================================================================
% db (database)
%==============================================================================
% A database: a cylinder seen from the side with two rings (stacked disks).
% Radii rx, ry of the ellipses and the heights yt, yb of the centres of the
% top and bottom ellipse, in units of half the node size.
\def\moeptikz@db@rx{.8}
\def\moeptikz@db@ry{.26}
\def\moeptikz@db@yt{.62}
\def\moeptikz@db@yb{-.62}
% outline (see \moeptikz@polyborder): back half of the top ellipse and front
% half of the bottom ellipse, every 15 degrees; computed once at load time
\def\moeptikz@db@outline{}
\foreach \moeptikz@a in {0,15,...,180} {%
	\pgfmathsetmacro\moeptikz@xa{\moeptikz@db@rx*cos(\moeptikz@a)}%
	\pgfmathsetmacro\moeptikz@ya{\moeptikz@db@yt+\moeptikz@db@ry*sin(\moeptikz@a)}%
	\xdef\moeptikz@db@outline{\moeptikz@db@outline{\moeptikz@xa}{\moeptikz@ya}}%
}
\foreach \moeptikz@a in {180,195,...,360} {%
	\pgfmathsetmacro\moeptikz@xa{\moeptikz@db@rx*cos(\moeptikz@a)}%
	\pgfmathsetmacro\moeptikz@ya{\moeptikz@db@yb+\moeptikz@db@ry*sin(\moeptikz@a)}%
	\xdef\moeptikz@db@outline{\moeptikz@db@outline{\moeptikz@xa}{\moeptikz@ya}}%
}
% heights of the two rings
\pgfmathsetmacro\moeptikz@db@ya{\moeptikz@db@yt-(\moeptikz@db@yt-\moeptikz@db@yb)/3}
\pgfmathsetmacro\moeptikz@db@yc{\moeptikz@db@yt-2*(\moeptikz@db@yt-\moeptikz@db@yb)/3}

% \moeptikz@db@pt{x}{y}: point in units of half the node size
\def\moeptikz@db@pt#1#2{\pgfqpoint{#1\moeptikz@fw@unit}{#2\moeptikz@fw@unit}}
% front half of the ellipse at height #1 (from left to right)
\def\moeptikz@db@arc#1{%
	\pgfpathmoveto{\moeptikz@db@pt{-\moeptikz@db@rx}{#1}}%
	\pgfpatharcaxes{180}{360}{\moeptikz@db@pt{\moeptikz@db@rx}{0}}%
		{\moeptikz@db@pt{0}{\moeptikz@db@ry}}%
}
\def\moeptikz@db@border{%
	\moeptikz@setshading
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\pgfmathsetlength\pgf@xa{.025*\moeptikz@size}%
	\pgfsetlinewidth{\pgf@xa}%
	\pgfsetstrokecolor{black}%
	% body: sides and front half of the bottom ellipse
	\pgfpathmoveto{\moeptikz@db@pt{-\moeptikz@db@rx}{\moeptikz@db@yt}}%
	\pgfpathlineto{\moeptikz@db@pt{-\moeptikz@db@rx}{\moeptikz@db@yb}}%
	\pgfpatharcaxes{180}{360}{\moeptikz@db@pt{\moeptikz@db@rx}{0}}%
		{\moeptikz@db@pt{0}{\moeptikz@db@ry}}%
	\pgfpathlineto{\moeptikz@db@pt{\moeptikz@db@rx}{\moeptikz@db@yt}}%
	\pgfpathclose
	\pgfshadepath{moeptikz@shading}{0}%
	\pgfusepath{stroke}%
	% rings
	\moeptikz@db@arc{\moeptikz@db@ya}%
	\moeptikz@db@arc{\moeptikz@db@yc}%
	\pgfusepath{stroke}%
	% top
	\pgfpathellipse{\moeptikz@db@pt{0}{\moeptikz@db@yt}}%
		{\moeptikz@db@pt{\moeptikz@db@rx}{0}}{\moeptikz@db@pt{0}{\moeptikz@db@ry}}%
	\pgfshadepath{moeptikz@shading}{90}%
	\pgfusepath{stroke}%
}
\def\moeptikz@db@anchorborder{\moeptikz@polyborder\moeptikz@db@outline}
\pgfdeclareshape{@db}{
	\moeptikz@savedmacros
	\anchor{center}{\pgfpointorigin}
	\anchorborder{\moeptikz@db@anchorborder}
	\backgroundpath{\moeptikz@background\moeptikz@db@border}
	% compass anchors on the outline
	\anchor{north}{\pgf@x=0pt\pgf@y=1pt\moeptikz@db@anchorborder}
	\anchor{south}{\pgf@x=0pt\pgf@y=-1pt\moeptikz@db@anchorborder}
	\anchor{east}{\pgf@x=1pt\pgf@y=0pt\moeptikz@db@anchorborder}
	\anchor{west}{\pgf@x=-1pt\pgf@y=0pt\moeptikz@db@anchorborder}
	\anchor{north east}{\pgf@x=1pt\pgf@y=1pt\moeptikz@db@anchorborder}
	\anchor{north west}{\pgf@x=-1pt\pgf@y=1pt\moeptikz@db@anchorborder}
	\anchor{south east}{\pgf@x=1pt\pgf@y=-1pt\moeptikz@db@anchorborder}
	\anchor{south west}{\pgf@x=-1pt\pgf@y=-1pt\moeptikz@db@anchorborder}
	\anchor{text}{\moeptikz@textanchor{\moeptikz@db@anchorborder}}
}

\tikzset{
db/.style 2 args={
	shape=@db,
	minimum size=#1,
	fill=#2
},
db/.default={1cm}{black}
}

%==============================================================================
% rack
%==============================================================================
% Servers on top of each other: the fronts of the server, scaled in height
% such that the rack is as high as a router or a switch, and the lid of the
% server on top.  Units of half the node size; the front of a server spans
% .22, its lid .58.
\def\moeptikz@rack@h{1.85}
% \moeptikz@rack@geometry{number of servers}: computed once at load time
\def\moeptikz@rack@geometry#1{%
	\pgfmathsetmacro\moeptikz@rack@f{(\moeptikz@rack@h-.58)/(#1*.22)}%
	\pgfmathsetmacro\moeptikz@rack@step{.22*\moeptikz@rack@f}%
	% bottom of the fronts, top of the fronts, top of the lid
	\pgfmathsetmacro\moeptikz@rack@ya{-\moeptikz@rack@h/2}%
	\pgfmathsetmacro\moeptikz@rack@yd{\moeptikz@rack@ya+#1*\moeptikz@rack@step}%
	\pgfmathsetmacro\moeptikz@rack@ye{\moeptikz@rack@yd+.58}%
	% bottoms of the single fronts
	\gdef\moeptikz@rack@fronts{}%
	\pgfmathtruncatemacro\moeptikz@rack@last{#1-1}%
	\foreach \moeptikz@k in {0,...,\moeptikz@rack@last} {%
		\pgfmathsetmacro\moeptikz@tmp{\moeptikz@rack@ya+\moeptikz@k*\moeptikz@rack@step}%
		\xdef\moeptikz@rack@fronts{\unexpanded\expandafter{\moeptikz@rack@fronts}%
			\noexpand\moeptikz@rack@server{\moeptikz@tmp}}%
	}%
	% outline (see \moeptikz@polyborder)
	\xdef\moeptikz@rack@outline{%
		{-1}{\moeptikz@rack@ya}{1}{\moeptikz@rack@ya}%
		{1}{\moeptikz@rack@yd}{.97}{\moeptikz@rack@yd}%
		{.75}{\moeptikz@rack@ye}{-.75}{\moeptikz@rack@ye}%
		{-.97}{\moeptikz@rack@yd}{-1}{\moeptikz@rack@yd}}%
}
\moeptikz@rack@geometry{4}

% front of a server whose bottom is at height #1
\def\moeptikz@rack@server#1{%
	\pgfscope
		\pgftransformshift{\pgfqpoint{0pt}{#1\moeptikz@fw@unit}}%
		\pgftransformyscale{\moeptikz@rack@f}%
		\pgftransformshift{\pgfqpoint{0pt}{.4\moeptikz@fw@unit}}%
		\moeptikz@server@front
		\moeptikz@server@details
	\endpgfscope
}
\def\moeptikz@rack@border{%
	\moeptikz@server@setup
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\moeptikz@rack@fronts
	% lid of the server on top (it starts at -.18 in the server)
	\pgfscope
		\pgftransformshift{\pgfqpoint{0pt}
			{\dimexpr\moeptikz@rack@yd\moeptikz@fw@unit+.18\moeptikz@fw@unit\relax}}%
		\moeptikz@server@lid
	\endpgfscope
}
\def\moeptikz@rack@anchorborder{\moeptikz@polyborder\moeptikz@rack@outline}
\pgfdeclareshape{@rack}{
	% saved anchors and macros of the server (\northeast is used by its
	% drawing code)
	\inheritsavedanchors[from=@server]
	\anchor{center}{\pgfpointorigin}
	\anchorborder{\moeptikz@rack@anchorborder}
	\backgroundpath{\moeptikz@background\moeptikz@rack@border}
	% compass anchors on the outline
	\anchor{north}{\pgf@x=0pt\pgf@y=1pt\moeptikz@rack@anchorborder}
	\anchor{south}{\pgf@x=0pt\pgf@y=-1pt\moeptikz@rack@anchorborder}
	\anchor{east}{\pgf@x=1pt\pgf@y=0pt\moeptikz@rack@anchorborder}
	\anchor{west}{\pgf@x=-1pt\pgf@y=0pt\moeptikz@rack@anchorborder}
	\anchor{north east}{\pgf@x=1pt\pgf@y=1pt\moeptikz@rack@anchorborder}
	\anchor{north west}{\pgf@x=-1pt\pgf@y=1pt\moeptikz@rack@anchorborder}
	\anchor{south east}{\pgf@x=1pt\pgf@y=-1pt\moeptikz@rack@anchorborder}
	\anchor{south west}{\pgf@x=-1pt\pgf@y=-1pt\moeptikz@rack@anchorborder}
	\anchor{text}{\moeptikz@textanchor{\moeptikz@rack@anchorborder}}
}

\tikzset{
rack/.style 2 args={
	shape=@rack,
	minimum size=#1,
	fill=#2
},
rack/.default={1cm}{black}
}


%==============================================================================
% smartphone
%==============================================================================
% A smartphone: a black body with rounded corners, a screen shaded in the fill
% colour (like the display of the client), a speaker and a home indicator.
% The body is extruded by (dx,dy) towards the back right to show its
% thickness; the whole phone is shifted by -(dx,dy)/2 to stay centred.  Units
% of half the node size.
\def\moeptikz@sp@dx{.05}
\def\moeptikz@sp@dy{.035}
% shifts of the copies of the body that form its thickness (from the back to
% the front) and of the front; computed once at load time
\gdef\moeptikz@sp@copies{}
\foreach \moeptikz@k in {10,9,...,1} {%
	\pgfmathsetmacro\moeptikz@xa{(\moeptikz@k/10-.5)*\moeptikz@sp@dx}%
	\pgfmathsetmacro\moeptikz@ya{(\moeptikz@k/10-.5)*\moeptikz@sp@dy}%
	\xdef\moeptikz@sp@copies{\unexpanded\expandafter{\moeptikz@sp@copies}%
		\noexpand\moeptikz@sp@body{\moeptikz@xa}{\moeptikz@ya}}%
}
\pgfmathsetmacro\moeptikz@sp@fx{-\moeptikz@sp@dx/2}
\pgfmathsetmacro\moeptikz@sp@fy{-\moeptikz@sp@dy/2}
% outline (see \moeptikz@polyborder): front and back body, corners not rounded
\pgfmathsetmacro\moeptikz@xa{-.45+\moeptikz@sp@fx}
\pgfmathsetmacro\moeptikz@xb{.45+\moeptikz@sp@fx}
\pgfmathsetmacro\moeptikz@xc{.45-\moeptikz@sp@fx}
\pgfmathsetmacro\moeptikz@xd{-.45-\moeptikz@sp@fx}
\pgfmathsetmacro\moeptikz@ya{-.9+\moeptikz@sp@fy}
\pgfmathsetmacro\moeptikz@yb{-.9-\moeptikz@sp@fy}
\pgfmathsetmacro\moeptikz@yc{.9-\moeptikz@sp@fy}
\pgfmathsetmacro\moeptikz@yd{.9+\moeptikz@sp@fy}
\edef\moeptikz@smartphone@outline{%
	{\moeptikz@xa}{\moeptikz@ya}{\moeptikz@xb}{\moeptikz@ya}%
	{\moeptikz@xc}{\moeptikz@yb}{\moeptikz@xc}{\moeptikz@yc}%
	{\moeptikz@xd}{\moeptikz@yc}{\moeptikz@xa}{\moeptikz@yd}}

\def\moeptikz@sp@pt#1#2{\pgfqpoint{#1\moeptikz@fw@unit}{#2\moeptikz@fw@unit}}
% rectangle (x1,y1)-(x2,y2) with corner radius r
\def\moeptikz@sp@rect#1#2#3#4#5{%
	\pgfsetcornersarced{\moeptikz@sp@pt{#5}{#5}}%
	\pgfpathrectanglecorners{\moeptikz@sp@pt{#1}{#2}}{\moeptikz@sp@pt{#3}{#4}}%
	\pgfsetcornersarced{\pgfpointorigin}%
}
% a copy of the body shifted by (x,y)
\def\moeptikz@sp@body#1#2{%
	\pgfscope
		\pgftransformshift{\moeptikz@sp@pt{#1}{#2}}%
		\moeptikz@sp@rect{-.45}{-.9}{.45}{.9}{.13}%
		\pgfusepath{fill}%
	\endpgfscope
}
\def\moeptikz@smartphone@border{%
	\moeptikz@setshading
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\pgfmathsetlength\pgf@xa{.02*\moeptikz@size}%
	\pgfsetlinewidth{\pgf@xa}%
	% thickness
	\pgfsetfillcolor{black!55}%
	\moeptikz@sp@copies
	% front
	\pgftransformshift{\moeptikz@sp@pt{\moeptikz@sp@fx}{\moeptikz@sp@fy}}%
	\pgfsetfillcolor{black}%
	\pgfsetstrokecolor{black}%
	\moeptikz@sp@rect{-.45}{-.9}{.45}{.9}{.13}%
	\pgfusepath{fill,stroke}%
	% screen
	\moeptikz@sp@rect{-.38}{-.7}{.38}{.74}{.03}%
	\pgfshadepath{moeptikz@shadingnuc}{180}%
	\pgfusepath{}%
	% speaker and home indicator
	\pgfsetfillcolor{black!55}%
	\moeptikz@sp@rect{-.12}{.8}{.12}{.83}{.015}%
	\pgfusepath{fill}%
	\moeptikz@sp@rect{-.14}{-.8}{.14}{-.775}{.012}%
	\pgfusepath{fill}%
}
\def\moeptikz@smartphone@anchorborder{%
	\moeptikz@polyborder\moeptikz@smartphone@outline}
\pgfdeclareshape{@smartphone}{
	\moeptikz@savedmacros
	\anchor{center}{\pgfpointorigin}
	\anchorborder{\moeptikz@smartphone@anchorborder}
	\backgroundpath{\moeptikz@background\moeptikz@smartphone@border}
	% compass anchors on the outline
	\anchor{north}{\pgf@x=0pt\pgf@y=1pt\moeptikz@smartphone@anchorborder}
	\anchor{south}{\pgf@x=0pt\pgf@y=-1pt\moeptikz@smartphone@anchorborder}
	\anchor{east}{\pgf@x=1pt\pgf@y=0pt\moeptikz@smartphone@anchorborder}
	\anchor{west}{\pgf@x=-1pt\pgf@y=0pt\moeptikz@smartphone@anchorborder}
	\anchor{north east}{\pgf@x=1pt\pgf@y=1pt\moeptikz@smartphone@anchorborder}
	\anchor{north west}{\pgf@x=-1pt\pgf@y=1pt\moeptikz@smartphone@anchorborder}
	\anchor{south east}{\pgf@x=1pt\pgf@y=-1pt\moeptikz@smartphone@anchorborder}
	\anchor{south west}{\pgf@x=-1pt\pgf@y=-1pt\moeptikz@smartphone@anchorborder}
	\anchor{text}{\moeptikz@textanchor{\moeptikz@smartphone@anchorborder}}
}

\tikzset{
smartphone/.style 2 args={
	shape=@smartphone,
	minimum size=#1,
	fill=#2
},
smartphone/.default={1cm}{black}
}

%==============================================================================
% user
%==============================================================================
% A person: a head above shoulders (upper half of an ellipse) with a small gap
% in between, both shaded in the fill colour.  Units of half the node size.
% The centre of the node lies in the gap, hence the outline for the border is
% the convex hull of head and shoulders (computed beforehand); lines from the
% side end next to the neck, from above at the head, from below at the
% shoulders.
\def\moeptikz@user@outline{%
	{-0.75}{-0.9}{0.75}{-0.9}{0.7386}{-0.7524}{0.7048}{-0.6093}{0.3571}{0.63}%
	{0.3291}{0.69}{0.2911}{0.7443}{0.2443}{0.7911}{0.19}{0.8291}{0.13}{0.8571}%
	{0.066}{0.8742}{0}{0.88}{-0.066}{0.8742}{-0.13}{0.8571}{-0.19}{0.8291}%
	{-0.2443}{0.7911}{-0.2911}{0.7443}{-0.3291}{0.69}{-0.3571}{0.63}%
	{-0.7048}{-0.6093}{-0.7386}{-0.7524}%
}
\def\moeptikz@user@pt#1#2{\pgfqpoint{#1\moeptikz@fw@unit}{#2\moeptikz@fw@unit}}
\def\moeptikz@user@border{%
	\moeptikz@setshading
	\moeptikz@fw@unit=.5\dimexpr\moeptikz@size\relax
	\pgfmathsetlength\pgf@xa{.02*\moeptikz@size}%
	\pgfsetlinewidth{\pgf@xa}%
	\pgfsetstrokecolor{black}%
	% shoulders: upper half of the ellipse with centre (0,-.9), radii .75, .85
	\pgfpathmoveto{\moeptikz@user@pt{-.75}{-.9}}%
	\pgfpatharcaxes{180}{0}{\moeptikz@user@pt{.75}{0}}{\moeptikz@user@pt{0}{.85}}%
	\pgfpathclose
	\pgfshadepath{moeptikz@shading}{0}%
	\pgfusepath{stroke}%
	% head: circle with centre (0,.5), radius .38
	\pgfpathcircle{\moeptikz@user@pt{0}{.5}}{.38\moeptikz@fw@unit}%
	\pgfshadepath{moeptikz@shading}{0}%
	\pgfusepath{stroke}%
}
\def\moeptikz@user@anchorborder{\moeptikz@polyborder\moeptikz@user@outline}
\pgfdeclareshape{@user}{
	\moeptikz@savedmacros
	\anchor{center}{\pgfpointorigin}
	\anchorborder{\moeptikz@user@anchorborder}
	\backgroundpath{\moeptikz@background\moeptikz@user@border}
	% compass anchors on the outline
	\anchor{north}{\pgf@x=0pt\pgf@y=1pt\moeptikz@user@anchorborder}
	\anchor{south}{\pgf@x=0pt\pgf@y=-1pt\moeptikz@user@anchorborder}
	\anchor{east}{\pgf@x=1pt\pgf@y=0pt\moeptikz@user@anchorborder}
	\anchor{west}{\pgf@x=-1pt\pgf@y=0pt\moeptikz@user@anchorborder}
	\anchor{north east}{\pgf@x=1pt\pgf@y=1pt\moeptikz@user@anchorborder}
	\anchor{north west}{\pgf@x=-1pt\pgf@y=1pt\moeptikz@user@anchorborder}
	\anchor{south east}{\pgf@x=1pt\pgf@y=-1pt\moeptikz@user@anchorborder}
	\anchor{south west}{\pgf@x=-1pt\pgf@y=-1pt\moeptikz@user@anchorborder}
	\anchor{text}{\moeptikz@textanchor{\moeptikz@user@anchorborder}}
}

\tikzset{
